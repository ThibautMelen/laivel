{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nika.sh/laivel/team.schema.json",
  "title": "laivel team roster",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": true,
    "required": ["stem", "level", "rank", "publish", "confidence"],
    "properties": {
      "stem": { "type": "string", "minLength": 1 },
      "level": {
        "type": "string",
        "enum": ["white", "red", "blue", "green", "copper", "silver", "gold"]
      },
      "rank": { "type": "integer", "minimum": 0, "maximum": 6 },
      "publish": { "type": "string" },
      "confidence": { "type": "string", "enum": ["low", "medium", "high"] },
      "extract_ok": { "type": "boolean" },
      "contradiction": { "type": "boolean" }
    }
  }
}
